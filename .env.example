# ================================
# ShopGuard Environment Variables
# ================================
# Copy this to .env and fill in your values.
# For deployment, set these in your hosting platform's environment settings.
# NEVER commit .env to version control.

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Local Docker:   postgresql://shopguard:shopguard_dev@localhost:5432/shopguard
# Neon free:      postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/shopguard?sslmode=require
# Neon pooled:    postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/shopguard?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://shopguard:shopguard_dev@localhost:5432/shopguard

# For serverless (Vercel): keep at 1 to avoid exhausting Neon connection limit
# For Docker/self-hosted: set to 5-10
DATABASE_MAX_CONNECTIONS=1

# ── REDIS ─────────────────────────────────────────────────────────────────────
# Local Docker:    redis://localhost:6379
# Upstash free:    rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=redis://localhost:6379

# ── AUTH ──────────────────────────────────────────────────────────────────────
# Min 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-secret-at-least-32-chars

# ── APP URL ───────────────────────────────────────────────────────────────────
# Set to your Vercel URL after deploying: https://shopguard-xxx.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── WORKER ────────────────────────────────────────────────────────────────────
# embedded: worker runs inside web process (default dev, single-container, Vercel)
# standalone: separate worker container handles jobs (Docker Compose production)
WORKER_MODE=embedded

# Min 32 characters. Must match in both web and worker services.
WORKER_SECRET=change-this-to-random-32-char-secret

# ── ML SERVICE ────────────────────────────────────────────────────────────────
# Optional. Rules+baselines work without it.
# Local Docker:  http://localhost:8000
# Render:        https://shopguard-ml-xxxx.onrender.com
ML_SERVICE_URL=

# ── EMAIL (optional) ──────────────────────────────────────────────────────────
# Mock provider is used if not set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@yourstore.com

# ── ENVIRONMENT ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Sentry error tracking
SENTRY_DSN=
# S3-compatible file storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=shopguard-uploads
S3_REGION=ap-south-1
